# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Real grades written by the scraper (test copies); the shipped Guy-Scraper/data/grades.tsv stays header-only
Guy-Scraper/data/*.local.tsv

# Desktop app: installed tools and build output
Guy-Scraper/desktop/node_modules/
Guy-Scraper/desktop/dist/
Guy-Scraper/desktop/release/
# The Google client ID for a build (copy google-client.example.json to google-client.json)
Guy-Scraper/desktop/google-client.json

# Phone app (mobile/): installed tools, generated native builds, and signing keys. Signing keys must never be committed.
mobile/node_modules/
mobile/ios/App/Pods/
mobile/ios/App/build/
mobile/ios/DerivedData/
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/local.properties
*.keystore
*.jks
*.p12
*.mobileprovision
*.ipa
*.aab
