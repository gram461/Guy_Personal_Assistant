{
  "name": "synergy-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Phone app shell for Synergy (iPhone and Android), built with Capacitor",
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/cli": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capgo/inappbrowser": "8.6.14"
  },
  "scripts": {
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "sync": "cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "doctor": "cap doctor",
    "assets": "capacitor-assets generate --iconBackgroundColor '#4B3FC4' --splashBackgroundColor '#4B3FC4'"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0"
  }
}
